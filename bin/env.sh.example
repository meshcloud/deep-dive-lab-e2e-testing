# Copy to bin/env.sh (gitignored) and `source bin/env.sh`.

# ── meshStack API ────────────────────────────────────────────────────────────────────────────
# Read directly by the meshcloud/meshstack provider, so no `provider` block is needed anywhere.
# Create the key in meshPanel under your workspace → API Keys. It needs permission to manage
# building block definitions and building blocks in the workspace below.
export MESHSTACK_ENDPOINT="https://federation.my.meshcloud.io"
export MESHSTACK_API_KEY="00000000-0000-0000-0000-000000000000"
export MESHSTACK_API_SECRET="…"

# That is deliberately all there is. Everything that is not a credential — your workspace, the
# definition version the tests order against — lives in each chapter's own `.auto.tfvars` file,
# copied from the `auto.tfvars.example` next to it. Nothing about this workshop is configured by
# `TF_VAR_*`: `tofu test` does not type-decode complex `TF_VAR_*` values, so a structured variable
# handed over that way arrives mistyped in assertion scope.
#
# 04-ci/gha-config is the one directory that reads the three variables above as environment
# variables rather than through the provider — it copies them into a GitHub Environment so the
# nightly workflow can authenticate.
